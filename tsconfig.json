{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./typescript/src",
    "preserveSymlinks": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "typescript/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-py",
    "python",
    "dotnet",
    "test"
  ]
}
