{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./typescript",
    "rootDir": "./typescript",
    "preserveSymlinks": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "typescript/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "python",
    "dotnet",
    "test"
  ]
}
