<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven manifest for the AN5 Java runtime.

  There is no dependency block on purpose: the adapter speaks JDBC through `java.sql`, so a
  consumer picks the driver it already has. That is what lets the same runtime serve SQL
  Server, PostgreSQL and SQLite, and what keeps it usable on Android, where an adapter that
  dragged in three drivers would not fit.

  The Kotlin runtime is a separate module with its own manifest rather than a second source
  root here: it is a different language, and a JVM build resolves it as its own artifact.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.an5orm</groupId>
  <artifactId>an5-adapters-java</artifactId>
  <version>0.2.11</version>
  <packaging>jar</packaging>

  <name>AN5 ORM Java adapter</name>
  <description>Standalone JDBC runtime for AN5 ORM: dialect-aware CRUD, relation eager loading and vector search.</description>
  <url>https://github.com/an5ORM/an5Adapters</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>AN5 ORM</name>
      <organization>AN5</organization>
      <url>https://github.com/an5ORM</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/an5ORM/an5Adapters.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/an5ORM/an5Adapters.git</developerConnection>
    <url>https://github.com/an5ORM/an5Adapters</url>
  </scm>

  <properties>
    <!--
      Java 8 bytecode, not the JDK in use: Android desugars Java 8 but not Java 17 language
      features, so a runtime compiled to a newer target simply cannot be used on a device.
    -->
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <sourceDirectory>src/main/java</sourceDirectory>
    <testSourceDirectory>src/test/java</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <!--
          The runtime tests need a JDBC driver on the classpath, and SQLite is the one that
          has no licence or platform constraint. A plugin dependency is resolved for the
          plugin's own classloader, where `test` is not an allowed scope — `runtime` is the
          one that puts it on the test classpath, and a missing driver fails the build the
          moment surefire tries to open a connection: the generated SQL is only ever
          validated by running it.
        -->
        <configuration>
          <environmentVariables>
            <AN5_JAVA_TEST_DRIVER>sqlite</AN5_JAVA_TEST_DRIVER>
          </environmentVariables>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
            <scope>runtime</scope>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      `-Prelease` is the only thing that touches anything outside the checkout: sources,
      javadoc, a detached GPG signature and an upload to Maven Central. Everything else —
      `mvn install`, `mvn test`, a consumer resolving the jar — runs the plain build above
      with no account, no key and no network beyond the plugins it already downloads.

      Credentials come from ~/.m2/settings.xml: a server with id `central` (a Central Portal
      token, supplied to CI as MAVEN_CENTRAL_USERNAME/MAVEN_CENTRAL_TOKEN) and
      MAVEN_GPG_PASSPHRASE in the environment for the signing step.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <configuration>
              <passphrase>${env.MAVEN_GPG_PASSPHRASE}</passphrase>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.8.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
            <executions>
              <execution>
                <id>publish</id>
                <phase>verify</phase>
                <goals>
                  <goal>publish</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>