{
  "name": "@an5/adapters",
  "version": "0.2.12",
  "description": "Standalone language adapters for AN5 ORM - TypeScript, Python, .NET, Go, Rust, Java, Kotlin, Swift, and Google Sheets query execution.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./browser": "./dist/browser.js",
    "./config": "./dist/config.js",
    "./base": "./dist/base/index.js",
    "./base/*": "./dist/base/*",
    "./mssql": "./dist/mssql/index.js",
    "./postgres": "./dist/postgres/index.js",
    "./mysql": "./dist/mysql/index.js",
    "./sqlite": "./dist/sqlite/index.js",
    "./googlesheets": "./dist/googlesheets/index.js",
    "./googlesheets/*": "./dist/googlesheets/*",
    "./typescript": "./dist/index.js",
    "./typescript/*": "./dist/*",
    "./python": "./python/an5_adapter.py",
    "./dotnet": "./dotnet/An5Adapter.cs",
    "./golang": "./golang/an5_adapter.go",
    "./rust": "./rust/Cargo.toml",
    "./java": "./java/src/main/java",
    "./kotlin": "./kotlin/src/main/kotlin",
    "./swift": "./swift/Sources/An5Adapters",
    "./nbase": "./dist/nbase/index.js"
  },
  "author": "an5ORM",
  "homepage": "https://github.com/an5ORM/an5",
  "repository": {
    "type": "git",
    "url": "https://github.com/an5ORM/an5Adapters.git"
  },
  "keywords": [
    "an5",
    "orm",
    "adapter",
    "typescript",
    "python",
    "dotnet",
    "go",
    "golang",
    "rust",
    "java",
    "kotlin",
    "swift"
  ],
  "files": [
    "dist/**/*.{js,d.ts}",
    "native/sqlite/**/*",
    "!native/sqlite/build/**/*",
    "scripts/sqlite-native-build.js",
    "typescript/src/**/*.ts",
    "typescript/src/nbase/**/*.ts",
    "python/**/*.py",
    "dotnet/**/*",
    "golang/**/*",
    "rust/Cargo.toml",
    "rust/src/**/*",
    "java/pom.xml",
    "java/src/main/java/**/*",
    "java/src/test/java/**/*",
    "kotlin/build.gradle.kts",
    "kotlin/settings.gradle.kts",
    "kotlin/src/main/kotlin/**/*",
    "kotlin/src/test/kotlin/**/*",
    "swift/Package.swift",
    "swift/Sources/**/*",
    "swift/Tests/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "build:python": "(python -m build --outdir dist-py || python3 -m build --outdir dist-py)",
    "test": "node test/unit.test.js && node test/package.test.js && node test/nbase.test.js && node test/sqlite-vector.test.js && node --test test/version-sync.test.js && node --test test/query-semantics.test.js && node test/query-relations.integration.test.js && node --test test/sheets-oauth.test.js",
    "test:package:smoke": "node scripts/package-smoke.js",
    "test:integration:live": "node test/live-db.integration.test.js && node test/query-relations.integration.test.js",
    "test:python": "node scripts/python-tests.js",
    "test:dotnet": "node scripts/dotnet-compile-check.js && node scripts/dotnet-sqlite-smoke.js",
    "test:go": "cd golang && go test ./...",
    "test:rust": "node scripts/rust-compile-check.js",
    "test:java": "node scripts/java-compile-check.js && node scripts/java-sqlite-smoke.js",
    "test:kotlin": "node scripts/kotlin-compile-check.js",
    "test:gradle": "node scripts/kotlin-gradle-build.js",
    "test:swift": "node scripts/swift-test.js",
    "build:sqlite:native": "node scripts/sqlite-native-build.js",
    "test:sqlite:native": "node scripts/sqlite-native-test.js",
    "bench:sqlite:native": "node scripts/sqlite-native-test.js --benchmark"
  },
  "dependencies": {
    "googleapis": "^183.0.0",
    "mssql": "^12.5.5",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.8",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "typescript": "^7.0.2",
    "better-sqlite3": "^11.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "mysql2": "^3.0.0",
    "better-sqlite3": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  }
}
